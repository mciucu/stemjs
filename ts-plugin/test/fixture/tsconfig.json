{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM"],
        "strict": true,
        "strictPropertyInitialization": false,
        "experimentalDecorators": true,
        "skipLibCheck": true,
        "noEmit": true,
        "paths": {
            "@stemjs/*": ["../../../*"]
        },
        "plugins": [
            {
                "name": "ts-plugin-registered-styles",
                "stateModule": "@stemjs/state/StoreField"
            }
        ]
    },
    "include": ["stores.ts", "optional.ts", "constructor.ts"]
}

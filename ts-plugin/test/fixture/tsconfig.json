{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM"],
        "strict": true,
        "strictPropertyInitialization": false,
        "experimentalDecorators": true,
        "jsx": "react",
        "jsxFactory": "UI.createElement",
        "skipLibCheck": true,
        "noEmit": true,
        "paths": {
            "@stemjs/*": ["../../../*"]
        },
        "plugins": [
            {
                "name": "ts-plugin-registered-styles",
                "stemRoot": "@stemjs"
            }
        ]
    },
    "include": ["stores.ts", "optional.ts", "constructor.ts", "enums.ts", "registry.ts", "numeric.ts", "jsx.tsx", "children.tsx", "nested.tsx", "options.tsx", "../../../ui/jsx.d.ts"]
}
